    "# =============================================================================\n",
    "# SECTION 4 - RULE GENERATION\n",
    "# =============================================================================\n",
    "print(\"\\n\" + \"=\" * 70)\n",
    "print(\"SECTION 4 - FUZZY RULE GENERATION\")\n",
    "print(\"=\" * 70)\n",
    "\n",
    "TERMS = {\n",
    "    \"age\": [\"Young\",  \"Adult\",  \"Senior\"],\n",
    "    \"exp\": [\"Novice\", \"Average\",\"Expert\"],\n",
    "    \"va\":  [\"New\",    \"Mid\",    \"Old\"],\n",
    "    \"val\": [\"Budget\", \"Mid\",    \"Luxury\"],\n",
    "    \"cc\":  [\"Small\",  \"Medium\", \"High\"],\n",
    "}\n",
    "KEYS = list(TERMS.keys())\n",
    "ALL_COMBOS = list(itertools.product(*[TERMS[k] for k in KEYS]))\n",
    "N_RULES = len(ALL_COMBOS)   # 243\n",
    "\n",
    "print(f\"\\nTotal rules (3^5 = 3 terms x 5 variables): {N_RULES}\")\n",
    "print(f\"\\nFirst 10 rules:\")\n",
    "print(f\"{'#':<5} {'age':<10} {'exp':<10} {'va':<8} {'val':<10} {'cc':<10}\")\n",
    "print(\"-\" * 55)\n",
    "for i, combo in enumerate(ALL_COMBOS[:10]):\n",
    "    print(f\"{i+1:<5} {combo[0]:<10} {combo[1]:<10} {combo[2]:<8} \"\n",
    "          f\"{combo[3]:<10} {combo[4]:<10}\")\n",
    "print(f\" ... and {N_RULES - 10} more rules (total {N_RULES})\")\n",
    "\n",
    "# =============================================================================\n",
    "# SECTION 5 - NEURO-FUZZY MODEL (ANFIS) TRAINING\n",
    "# =============================================================================\n",
    "print(\"\\n\" + \"=\" * 70)\n",
    "print(\"SECTION 5 - NEURO-FUZZY TRAINING  (ANFIS, 60 epochs)\")\n",
    "print(\"=\" * 70)\n",
    "\n",
    "# --- 5a. Data tensors ---\n",
    "df_m = df.dropna(subset=FEATURE_COLS + TARGET_COLS).copy()\n",
    "df_m.reset_index(drop=True, inplace=True)\n",
    "\n",
    "X_raw = df_m[FEATURE_COLS].astype(float).values\n",
    "yN    = df_m[\"N_claims_year\"].astype(float).values\n",
    "\n",
    "sev_m  = df_m[df_m[\"Cost_claims_year\"] > 0].copy()\n",
    "Xs_raw = sev_m[FEATURE_COLS].astype(float).values\n",
    "yS_raw = sev_m[\"Cost_claims_year\"].astype(float).values\n",
    "\n",
    "# Winsorise + log1p for severity training\n",
    "yS_p99  = float(np.percentile(yS_raw, 99.5))\n",
    "yS_win  = np.clip(yS_raw, 0, yS_p99)\n",
    "yS_log  = np.log1p(yS_win)\n",
    "\n",
    "# Standardise\n",
    "X_mean = X_raw.mean(axis=0)\n",
    "X_std  = X_raw.std(axis=0) + 1e-9\n",
    "\n",
    "X  = (X_raw  - X_mean) / X_std\n",
    "Xs = (Xs_raw - X_mean) / X_std\n",
    "\n",
    "X_t     = torch.tensor(X,      dtype=torch.float32)\n",
    "yN_t    = torch.tensor(yN,     dtype=torch.float32)\n",
    "Xs_t    = torch.tensor(Xs,     dtype=torch.float32)\n",
    "ySlog_t = torch.tensor(yS_log, dtype=torch.float32)\n",
    "\n",
    "BATCH_FREQ = 1024\n",
    "BATCH_SEV  = 512\n",
    "freq_loader = DataLoader(TensorDataset(X_t,  yN_t),    batch_size=BATCH_FREQ, shuffle=True)\n",
    "sev_loader  = DataLoader(TensorDataset(Xs_t, ySlog_t), batch_size=BATCH_SEV,  shuffle=True)\n",
    "\n",
    "print(f\"Freq dataset: {len(X_t):,} rows  |  Sev dataset: {len(Xs_t):,} rows\")\n",
    "\n",
    "\n",
    "# --- 5b. Trainable Gaussian MF (PyTorch) ---\n",
    "class GaussianMF(nn.Module):\n",
    "    \"\"\"Trainable Gaussian MF.\"\"\"\n",
    "    def __init__(self, a_init, b_init, c_init):\n",
    "        super().__init__()\n",
    "        self.mean_raw = nn.Parameter(torch.tensor(float(b_init)))\n",
    "        self.sigma_raw = nn.Parameter(torch.tensor(float(max(c_init - a_init, 1e-3)) / 4.0))\n",
    "        self.sp = nn.Softplus()\n",
    "\n",
    "    def forward(self, x):\n",
    "        mean = self.mean_raw\n",
    "        sigma = self.sp(self.sigma_raw) + 1e-4\n",
    "        return torch.exp(-0.5 * ((x - mean) / sigma)**2)\n",
    "\n",
    "\n",
    "# --- 5c. Fuzzifier ---\n",
    "class Fuzzifier(nn.Module):\n",
    "    \"\"\"\n",
    "    Fuzzifies 5 inputs into membership degrees:\n",
    "      Age, Experience, VehicleAge: fuzzified in standardised space.\n",
    "      Value_vehicle:  un-standardised then log1p, then normalised\n",
    "                      so MF anchors remain interpretable in EUR.\n",
    "      CC:             fuzzified in standardised space.\n",
    "    \"\"\"\n",
    "    def __init__(self, x_mean_np, x_std_np):\n",
    "        super().__init__()\n",
    "        self.register_buffer(\"xm\", torch.tensor(x_mean_np, dtype=torch.float32))\n",
    "        self.register_buffer(\"xs\", torch.tensor(x_std_np,  dtype=torch.float32))\n",
    "\n",
    "        def s(v, col):\n",
    "            return float((v - x_mean_np[col]) / x_std_np[col])\n",
    "\n",
    "        # Age (col 0)\n",
    "        self.age_young  = GaussianMF(s(16,0), s(25,0), s(35,0))\n",
    "        self.age_adult  = GaussianMF(s(28,0), s(42,0), s(58,0))\n",
    "        self.age_senior = GaussianMF(s(52,0), s(65,0), s(85,0))\n",
    "\n",
    "        # Driving experience (col 1)\n",
    "        self.exp_novice  = GaussianMF(s( 0,1), s( 2,1), s( 5,1))\n",
    "        self.exp_average = GaussianMF(s( 3,1), s( 8,1), s(15,1))\n",
    "        self.exp_expert  = GaussianMF(s(12,1), s(22,1), s(40,1))\n",
    "\n",
    "        # Vehicle age (col 2)\n",
    "        self.va_new = GaussianMF(s( 0,2), s( 2,2), s( 5,2))\n",
    "        self.va_mid = GaussianMF(s( 3,2), s( 7,2), s(12,2))\n",
    "        self.va_old = GaussianMF(s( 9,2), s(16,2), s(30,2))\n",
    "\n",
    "        # Vehicle value (col 3) -- MF anchors in log1p(EUR)\n",
    "        lv_mean = float(np.log1p(x_mean_np[3]))\n",
    "        lv_std  = float(np.log1p(x_mean_np[3] + x_std_np[3]) - lv_mean + 1e-9)\n",
    "        self.register_buffer(\"lv_mean\", torch.tensor(lv_mean, dtype=torch.float32))\n",
    "        self.register_buffer(\"lv_std\",  torch.tensor(lv_std,  dtype=torch.float32))\n",
    "\n",
    "        def sl(v):\n",
    "            return float((np.log1p(v) - lv_mean) / (lv_std + 1e-9))\n",
    "\n",
    "        self.val_budget = GaussianMF(sl(  500), sl( 3500), sl( 9000))\n",
    "        self.val_mid    = GaussianMF(sl( 7000), sl(15000), sl(25000))\n",
    "        self.val_luxury = GaussianMF(sl(20000), sl(35000), sl(53000))\n",
    "\n",
    "        # Cylinder capacity (col 4)\n",
    "        self.cc_small  = GaussianMF(s( 600,4), s(1000,4), s(1400,4))\n",
    "        self.cc_medium = GaussianMF(s(1100,4), s(1600,4), s(2100,4))\n",
    "        self.cc_high   = GaussianMF(s(1800,4), s(2600,4), s(4000,4))\n",
    "\n",
    "    def forward(self, X):\n",
    "        age = X[:, 0]\n",
    "        exp = X[:, 1]\n",
    "        va  = X[:, 2]\n",
    "        cc  = X[:, 4]\n",
    "\n",
    "        # Recover original Value_vehicle, then log1p-normalise\n",
    "        val_orig = X[:, 3] * self.xs[3] + self.xm[3]\n",
    "        val_orig = torch.clamp(val_orig, min=0.0)\n",
    "        val_log  = (torch.log1p(val_orig) - self.lv_mean) / (self.lv_std + 1e-8)\n",
    "\n",
    "        m = {\n",
    "            \"age\": torch.stack([self.age_young(age),    self.age_adult(age),    self.age_senior(age)],  dim=1),\n",
    "            \"exp\": torch.stack([self.exp_novice(exp),    self.exp_average(exp),  self.exp_expert(exp)],  dim=1),\n",
    "            \"va\":  torch.stack([self.va_new(va),          self.va_mid(va),         self.va_old(va)],       dim=1),\n",
    "            \"val\": torch.stack([self.val_budget(val_log), self.val_mid(val_log),   self.val_luxury(val_log)], dim=1),\n",
    "            \"cc\":  torch.stack([self.cc_small(cc),        self.cc_medium(cc),      self.cc_high(cc)],      dim=1),\n",
    "        }\n",
    "        for k in m:\n",
    "            s = m[k].sum(dim=1, keepdim=True).clamp_min(1e-8)\n",
    "            m[k] = m[k] / s\n",
    "        return m\n",
    "\n",
    "\n",
    "# --- 5d. ANFIS model ---\n",
    "class ANFIS(nn.Module):\n",
    "    \"\"\"\n",
    "    243 rules (3^5). Each rule has a scalar consequent for freq and sev.\n",
    "    Global linear layer + rule biases + 2-layer MLP refinement.\n",
    "    MLP receives concatenation of [standardised features, rule weights].\n",
    "    \"\"\"\n",
    "    def __init__(self, x_mean_np, x_std_np, input_dim=5, n_rules=243):\n",
    "        super().__init__()\n",
    "        self.fuzz    = Fuzzifier(x_mean_np, x_std_np)\n",
    "        self.n_rules = n_rules\n",
    "\n",
    "        self.rule_bias_freq = nn.Parameter(torch.zeros(n_rules))\n",
    "        self.rule_bias_sev  = nn.Parameter(torch.zeros(n_rules))\n",
    "\n",
    "        self.lin_freq = nn.Linear(input_dim, 1)\n",
    "        self.lin_sev  = nn.Linear(input_dim, 1)\n",
    "\n",
    "        hid = 128\n",
    "        self.mlp_freq = nn.Sequential(\n",
    "            nn.Linear(input_dim + n_rules, hid), nn.GELU(), nn.Dropout(0.25),\n",
    "            nn.Linear(hid, 32), nn.GELU(),\n",
    "            nn.Linear(32, 1)\n",
    "        )\n",
    "        self.mlp_sev = nn.Sequential(\n",
    "            nn.Linear(input_dim + n_rules, hid), nn.GELU(), nn.Dropout(0.25),\n",
    "            nn.Linear(hid, 32), nn.GELU(),\n",
    "            nn.Linear(32, 1)\n",
    "        )\n",
    "        self.dropout = nn.Dropout(0.25)\n",
    "\n",
    "    def _rule_weights(self, m):\n",
    "        B = m[\"age\"].shape[0]\n",
    "        age = m[\"age\"][:, :, None, None, None, None]\n",
    "        exp = m[\"exp\"][:, None, :, None, None, None]\n",
    "        va  = m[\"va\"][ :, None, None, :, None, None]\n",
    "        val = m[\"val\"][:, None, None, None, :, None]\n",
    "        cc  = m[\"cc\"][ :, None, None, None, None, :]\n",
    "        firing = (age * exp * va * val * cc).reshape(B, self.n_rules)\n",
    "        s = firing.sum(dim=1, keepdim=True).clamp_min(1e-8)\n",
    "        return firing / s\n",
    "\n",
    "    def forward(self, X):\n",
    "        m   = self.fuzz(X)\n",
    "        w   = self._rule_weights(m)\n",
    "        w_d = self.dropout(w)\n",
    "        feat = torch.cat([X, w_d], dim=1)\n",
    "\n",
    "        log_lam = (self.lin_freq(X).squeeze(1)\n",
    "                   + w_d @ self.rule_bias_freq\n",
    "                   + self.mlp_freq(feat).squeeze(1))\n",
    "        log_lam = torch.clamp(log_lam, -10.0, 5.0)\n",
    "\n",
    "        log_sev = (self.lin_sev(X).squeeze(1)\n",
    "                   + w_d @ self.rule_bias_sev\n",
    "                   + self.mlp_sev(feat).squeeze(1))\n",
    "        log_sev = torch.clamp(log_sev, -2.0, 10.5)\n",
    "\n",
    "        return log_lam, log_sev\n",
    "\n",
    "\n",
    "# --- 5e. Pairwise ranking loss ---\n",
    "def pairwise_ranking_loss(pred, target, n_pairs=2048):\n",
    "    \"\"\"Differentiable Gini surrogate: penalise rank inversions.\"\"\"\n",
    "    if len(pred) < 2:\n",
    "        return torch.tensor(0.0, device=pred.device)\n",
    "    idx = torch.randint(0, len(pred), (n_pairs, 2), device=pred.device)\n",
    "    i, j = idx[:, 0], idx[:, 1]\n",
    "    dy = target[i] - target[j]\n",
    "    dp = pred[i]   - pred[j]\n",
    "    return F.softplus(-dy * dp / (dy.abs().clamp_min(1e-4))).mean()\n",
    "\n",
    "\n",
    "# --- 5f. Training ---\n",
    "EPOCHS       = 60\n",
    "LR           = 5e-4\n",
    "WEIGHT_DECAY = 1e-3\n",
    "L1_WEIGHT    = 1e-4   # For pruning rule biases\n",
    "REG_RULE     = 1e-6   # L2\n",
    "RANK_WEIGHT  = 0.10\n",
    "PATIENCE     = 15\n",
    "\n",
    "model_nf = ANFIS(X_mean, X_std, input_dim=5, n_rules=N_RULES).to(DEVICE)\n",
    "opt      = torch.optim.AdamW(model_nf.parameters(), lr=LR, weight_decay=WEIGHT_DECAY)\n",
    "sched    = CosineAnnealingLR(opt, T_max=EPOCHS, eta_min=LR * 0.05)\n",
    "\n",
    "print(f\"\\nTraining ANFIS: {EPOCHS} epochs, LR={LR}, rank_weight={RANK_WEIGHT}\")\n",
    "best_freq_loss   = float(\"inf\")\n",
    "patience_counter = 0\n",
    "history          = []\n",
    "t0 = time.time()\n",
    "\n",
    "for ep in range(1, EPOCHS + 1):\n",
    "    model_nf.train()\n",
    "    fl_list, sl_list = [], []\n",
    "\n",
    "    for xb, yb in freq_loader:\n",
    "        xb, yb = xb.to(DEVICE), yb.to(DEVICE)\n",
    "        opt.zero_grad()\n",
    "        log_lam, _ = model_nf(xb)\n",
    "        lam = F.softplus(log_lam)\n",
    "        loss_f = F.poisson_nll_loss(lam, yb, log_input=False, full=False, reduction=\"mean\")\n",
    "        rank_f = pairwise_ranking_loss(lam, yb)\n",
    "        reg_l2 = REG_RULE * (model_nf.rule_bias_freq.pow(2).mean() + model_nf.rule_bias_sev.pow(2).mean())\n",
    "        reg_l1 = L1_WEIGHT * (model_nf.rule_bias_freq.abs().mean() + model_nf.rule_bias_sev.abs().mean())\n",
    "        loss   = loss_f + RANK_WEIGHT * rank_f + reg_l2 + reg_l1\n",
    "        if not torch.isnan(loss):\n",
    "            loss.backward()\n",
    "            torch.nn.utils.clip_grad_norm_(model_nf.parameters(), 2.0)\n",
    "            opt.step()\n",
    "            fl_list.append(loss_f.item())\n",
    "\n",
    "    for xb, yb_log in sev_loader:\n",
    "        xb, yb_log = xb.to(DEVICE), yb_log.to(DEVICE)\n",
    "        opt.zero_grad()\n",
    "        _, log_sev = model_nf(xb)\n",
    "        loss_s = F.smooth_l1_loss(log_sev, yb_log, beta=1.0)\n",
    "        rank_s = pairwise_ranking_loss(log_sev, yb_log)\n",
    "        reg_l2 = REG_RULE * model_nf.rule_bias_sev.pow(2).mean()\n",
    "        reg_l1 = L1_WEIGHT * model_nf.rule_bias_sev.abs().mean()\n",
    "        loss   = loss_s + RANK_WEIGHT * rank_s + reg_l2 + reg_l1\n",
    "        if not torch.isnan(loss):\n",
    "            loss.backward()\n",
    "            torch.nn.utils.clip_grad_norm_(model_nf.parameters(), 2.0)\n",
    "            opt.step()\n",
    "            sl_list.append(loss_s.item())\n",
    "\n",
    "    sched.step()\n",
    "    fl = float(np.mean(fl_list)) if fl_list else float(\"nan\")\n",
    "    sl = float(np.mean(sl_list)) if sl_list else float(\"nan\")\n",
    "    history.append({\"epoch\": ep, \"freq_loss\": fl, \"sev_loss\": sl})\n",
    "\n",
    "    if ep % 10 == 0 or ep == 1:\n",
    "        print(f\"  Epoch {ep:03d}/{EPOCHS} | freq_loss={fl:.5f} \"\n",
    "              f\"| sev_logHuber={sl:.5f} | {time.time()-t0:.0f}s\")\n",
    "\n",
    "    if fl < best_freq_loss - 1e-6:\n",
    "        best_freq_loss = fl; patience_counter = 0\n",
    "    else:\n",
    "        patience_counter += 1\n",
    "    if patience_counter >= PATIENCE:\n",
    "        print(f\"  Early stopping at epoch {ep} (patience={PATIENCE})\")\n",
    "        break\n",
    "\n",
    "print(f\"Training done in {time.time()-t0:.1f}s\")\n",
    "active_freq = (model_nf.rule_bias_freq.abs() > 1e-3).sum().item()\n",
    "active_sev = (model_nf.rule_bias_sev.abs() > 1e-3).sum().item()\n",
    "print(f\"Active Rules (Freq): {active_freq} / {N_RULES}\")\n",
    "print(f\"Active Rules (Sev) : {active_sev} / {N_RULES}\")\n",
    "\n",
    "# =============================================================================\n",
    "# SECTION 6 - PREMIUM CALCULATION + CALIBRATION + ENSEMBLE\n",
    "# =============================================================================\n",
    "print(\"\\n\" + \"=\" * 70)\n",
    "print(\"SECTION 6 - PREMIUM CALCULATION & CALIBRATION\")\n",
    "print(\"=\" * 70)\n",
    "\n",
    "model_nf.eval()\n",
    "\n",
    "@torch.no_grad()\n",
    "def nf_raw(X_np):\n",
    "    \"\"\"Raw log_lam, log_sev for a batch of raw (unstandardised) features.\"\"\"\n",
    "    Xn = (X_np - X_mean) / X_std\n",
    "    xt = torch.tensor(Xn, dtype=torch.float32, device=DEVICE)\n",
    "    ll, ls = model_nf(xt)\n",
    "    return ll.cpu().numpy(), ls.cpu().numpy()\n",
    "\n",
    "\n",
    "# Calibrate frequency: shift so mean(lam) = obs_freq\n",
    "ll_all, ls_all = nf_raw(df_m[FEATURE_COLS].values.astype(np.float32))\n",
    "lam_all = np.log1p(np.exp(np.clip(ll_all, -50, 50)))\n",
    "calib_lam = float(np.log(obs_freq + 1e-12) - np.log(lam_all.mean() + 1e-12))\n",
    "\n",
    "# Calibrate severity: multiplicative so mean(sev_pred) = obs_sev\n",
    "ls_sev = nf_raw(sev_m[FEATURE_COLS].values.astype(np.float32))[1]\n",
    "pred_sev_mean = float(np.exp(np.clip(ls_sev, -20, 13)).mean())\n",
    "calib_sev  = float(obs_sev / (pred_sev_mean + 1e-8))\n",
    "\n",
    "print(f\"Frequency calibration shift  : {calib_lam:+.4f}\")\n",
    "print(f\"Severity calibration factor  : {calib_sev:.4f}\")\n",
    "\n",
    "\n",
    "@torch.no_grad()\n",
    "def nf_predict(X_np):\n",
    "    \"\"\"Calibrated lambda and severity.\"\"\"\n",
    "    ll, ls = nf_raw(X_np)\n",
    "    lam = np.log1p(np.exp(np.clip(ll + calib_lam, -50, 50)))\n",
    "    sev = np.exp(np.clip(ls, -20, 13)) * calib_sev\n",
    "    return np.clip(lam, 0, None), np.clip(sev, 0, None)\n",
    "\n",
    "\n",
    "X_all_raw = df_m[FEATURE_COLS].values.astype(np.float32)\n",
    "nf_lam, nf_sev_pred = nf_predict(X_all_raw)\n",
    "\n",
    "df_m[\"nf_freq\"]         = nf_lam\n",
    "df_m[\"nf_sev\"]          = nf_sev_pred\n",
    "df_m[\"nf_pure_premium\"] = nf_lam * nf_sev_pred\n",
    "df_m[\"glm_pure_premium\"] = nb_model.predict(df_m) * gamma_model.predict(df_m)\n",
    "df_m[\"obs_loss\"]         = df_m[\"Cost_claims_year\"].astype(float)\n",
    "\n",
    "print(f\"\\nPost-calibration:\")\n",
    "print(f\"  NF  mean freq : {nf_lam.mean():.4f}  (obs: {obs_freq:.4f})\")\n",
    "print(f\"  NF  mean sev  : {nf_sev_pred.mean():,.2f}  (obs: {obs_sev:,.2f})\")\n",
    "print(f\"  NF  mean PP   : {df_m['nf_pure_premium'].mean():,.2f}\")\n",
    "print(f\"  GLM mean PP   : {df_m['glm_pure_premium'].mean():,.2f}\")\n",
    "print(f\"  Obs pure prem : {obs_pure_prem:,.2f}\")\n",
    "\n",
    "# Diagnostic: check for NaN/Inf\n",
    "for col in [\"nf_freq\", \"nf_sev\", \"nf_pure_premium\", \"glm_pure_premium\"]:\n",
    "    n_bad = (~np.isfinite(df_m[col].values)).sum()\n",
    "    if n_bad: print(f\"  [WARN] {col}: {n_bad} non-finite values\")\n",
    "\n",
    "\n",
    "def gini_index(y_true, y_pred):\n",
    "    \"\"\"Normalised Gini (actuarial: sorted ascending by pred).\"\"\"\n",
    "    y_true = np.asarray(y_true, dtype=float)\n",
    "    y_pred = np.asarray(y_pred, dtype=float)\n",
    "    mask = np.isfinite(y_true) & np.isfinite(y_pred)\n",
    "    yt, yp = y_true[mask], y_pred[mask]\n",
    "    if len(yt) < 2 or yt.sum() <= 0:\n",
    "        return 0.0\n",
    "    order = np.argsort(yp)\n",
    "    yt_s  = yt[order]\n",
    "    cum_pop  = np.arange(1, len(yt_s) + 1) / len(yt_s)\n",
    "    cum_loss = np.cumsum(yt_s) / (yt_s.sum() + 1e-12)\n",
    "    return float(1.0 - 2.0 * auc(cum_pop, cum_loss))\n",
    "\n",
    "\n",
    "obs_v   = df_m[\"obs_loss\"].values\n",
    "glm_p   = df_m[\"glm_pure_premium\"].values\n",
    "nf_p    = df_m[\"nf_pure_premium\"].values\n",
    "\n",
    "# --- Linear ensemble sweep ---\n",
    "best_alpha = 0.5\n",
    "best_ens_g = -1.0\n",
    "for a in np.linspace(0, 1, 201):\n",
    "    g = gini_index(obs_v, a * glm_p + (1 - a) * nf_p)\n",
    "    if g > best_ens_g:\n",
    "        best_ens_g = g; best_alpha = a\n",
    "\n",
    "df_m[\"ens_pure_premium\"] = best_alpha * glm_p + (1 - best_alpha) * nf_p\n",
    "print(f\"\\nLinear ensemble: best alpha(GLM)={best_alpha:.2f}  Gini={best_ens_g:.4f}\")\n",
    "\n",
    "# --- Gradient Boosting stacker (key for Gini > 0.35) ---\n",
    "print(\"\\nFitting Gradient Boosting stacker ...\")\n",
    "\n",
    "# Rich feature set for stacking\n",
    "def build_stack_features(df_work):\n",
    "    glm_pp = np.clip(df_work[\"glm_pure_premium\"].values, 0, None)\n",
    "    nf_pp  = np.clip(df_work[\"nf_pure_premium\"].values,  0, None)\n",
    "    gf     = np.clip(df_work[\"glm_freq\"].values,         0, None)\n",
    "    nf_f   = np.clip(df_work[\"nf_freq\"].values,          0, None)\n",
    "\n",
    "    # Feature engineering: raw, log, ratio, product\n",
    "    return np.column_stack([\n",
    "        glm_pp,\n",
    "        nf_pp,\n",
    "        gf,                                   # GLM frequency signal\n",
    "        nf_f,                                 # NF frequency signal\n",
    "        np.log1p(glm_pp),\n",
    "        np.log1p(nf_pp),\n",
    "        np.log1p(gf),\n",
    "        np.log1p(nf_f),\n",
    "        glm_pp * nf_pp,                       # product interaction\n",
    "        np.abs(glm_pp - nf_pp),              # disagreement feature\n",
    "        (glm_pp / (nf_pp + 1e-8)).clip(0, 5), # ratio\n",
    "    ])\n",
    "\n",
    "stack_X = build_stack_features(df_m)\n",
    "stack_y = obs_v\n",
    "\n",
    "# Replace NaN/inf in stack features\n",
    "stack_X = np.nan_to_num(stack_X, nan=0.0, posinf=0.0, neginf=0.0)\n",
    "\n",
    "gb_stack = GradientBoostingRegressor(\n",
    "    n_estimators=500,\n",
    "    max_depth=4,\n",
    "    learning_rate=0.05,\n",
    "    subsample=0.8,\n",
    "    min_samples_leaf=50,\n",
    "    loss=\"huber\",\n",
    "    random_state=42,\n",
    ")\n",
    "gb_stack.fit(stack_X, stack_y)\n",
    "stack_raw = gb_stack.predict(stack_X)\n",
    "\n",
    "# Isotonic calibration to preserve mean\n",
    "iso = IsotonicRegression(out_of_bounds=\"clip\")\n",
    "# Use calibration: first clip to non-negative then isotonic calibrate\n",
    "stack_raw_clip = np.clip(stack_raw, 0, None)\n",
    "iso.fit(stack_raw_clip, stack_y)\n",
    "stack_calibrated = iso.predict(stack_raw_clip)\n",
    "df_m[\"stack_pure_premium\"] = np.clip(stack_calibrated, 0, None)\n",
    "\n",
    "print(f\"  Stack mean PP  : {df_m['stack_pure_premium'].mean():,.2f}\")\n",
    "\n",
    "# Quick Gini check\n",
    "print(\"\\nGini before final evaluation:\")\n",
    "for name, col in [(\"GLM\", \"glm_pure_premium\"), (\"NF\", \"nf_pure_premium\"),\n",
    "                  (\"Ensemble\", \"ens_pure_premium\"), (\"GBM-Stack\", \"stack_pure_premium\")]:\n",
    "    g = gini_index(obs_v, df_m[col].values)\n",
    "    flag = \"[OK >0.35]\" if g > 0.35 else \"\"\n",
    "    print(f\"  {name:<15}: Gini = {g:.4f}  {flag}\")\n",
    "\n",
    "# =============================================================================\n",
    "# SECTION 7 - EVALUATION: METRICS + PLOTS\n",
    "# =============================================================================\n",
    "print(\"\\n\" + \"=\" * 70)\n",
    "print(\"SECTION 7 - MODEL EVALUATION\")\n",
    "print(\"=\" * 70)\n",
    "\n",
    "print(\"\\nApplying models to Test Data for Out-of-Sample Evaluation ...\")\n",
    "df_test_m = df_test.dropna(subset=FEATURE_COLS + TARGET_COLS).copy()\n",
    "df_test_m.reset_index(drop=True, inplace=True)\n",
    "\n",
    "# 1. GLM\n",
    "df_test_m[\"glm_freq\"] = nb_model.predict(df_test_m)\n",
    "df_test_m[\"glm_sev\"] = gamma_model.predict(df_test_m)\n",
    "df_test_m[\"glm_pure_premium\"] = df_test_m[\"glm_freq\"] * df_test_m[\"glm_sev\"]\n",
    "\n",
    "# 2. NF\n",
    "X_test_raw = df_test_m[FEATURE_COLS].values.astype(np.float32)\n",
    "nf_lam_test, nf_sev_test = nf_predict(X_test_raw)\n",
    "df_test_m[\"nf_freq\"] = nf_lam_test\n",
    "df_test_m[\"nf_sev\"] = nf_sev_test\n",
    "df_test_m[\"nf_pure_premium\"] = nf_lam_test * nf_sev_test\n",
    "\n",
    "# 3. Ensemble\n",
    "df_test_m[\"ens_pure_premium\"] = best_alpha * df_test_m[\"glm_pure_premium\"] + (1 - best_alpha) * df_test_m[\"nf_pure_premium\"]\n",
    "\n",
    "# 4. GBM Stacker\n",
    "stack_X_test = build_stack_features(df_test_m)\n",
    "stack_X_test = np.nan_to_num(stack_X_test, nan=0.0, posinf=0.0, neginf=0.0)\n",
    "stack_raw_test = gb_stack.predict(stack_X_test)\n",
    "stack_raw_test_clip = np.clip(stack_raw_test, 0, None)\n",
    "df_test_m[\"stack_pure_premium\"] = np.clip(iso.predict(stack_raw_test_clip), 0, None)\n",
    "\n",
    "df_test_m[\"obs_loss\"] = df_test_m[\"Cost_claims_year\"].astype(float)\n",
    "obs_v_test = df_test_m[\"obs_loss\"].values\n",
    "\n",
    "# Winsorise observed for fair comparison based on training cap\n",
    "cap_obs = float(np.percentile(obs_v[obs_v > 0], 99.5))\n",
    "y_eval  = np.clip(obs_v_test, 0, cap_obs)\n",
    "print(f\"Observed loss capped at 99.5th pct (train) for evaluation: {cap_obs:,.0f}\")\n",
    "df_eval = df_test_m\n",
    "\n",
    "\n",
    "def lorenz_curve(y_true, y_pred):\n",
    "    y_true = np.asarray(y_true, dtype=float)\n",
    "    y_pred = np.asarray(y_pred, dtype=float)\n",
    "    mask = np.isfinite(y_true) & np.isfinite(y_pred)\n",
    "    yt, yp = y_true[mask], y_pred[mask]\n",
    "    if len(yt) < 2 or yt.sum() <= 0:\n",
    "        return np.array([0.0, 1.0]), np.array([0.0, 1.0])\n",
    "    order = np.argsort(yp)\n",
    "    yt_s  = yt[order]\n",
    "    n     = len(yt_s)\n",
    "    return np.arange(1, n + 1) / n, np.cumsum(yt_s) / (yt_s.sum() + 1e-12)\n",
    "\n",
    "\n",
    "def compute_metrics(y_true, y_pred, name):\n",
    "    mask = np.isfinite(y_true) & np.isfinite(y_pred)\n",
    "    yt, yp = y_true[mask], y_pred[mask]\n",
    "    if len(yt) < 2:\n",
    "        return {\"Model\": name, \"n\": 0, \"MAE\": np.nan, \"RMSE\": np.nan,\n",
    "                \"Gini\": np.nan, \"Mean_Pred\": np.nan, \"Mean_Obs\": np.nan, \"Pred_Obs_Ratio\": np.nan}\n",
    "    return {\n",
    "        \"Model\": name,\n",
    "        \"n\": int(mask.sum()),\n",
    "        \"MAE\":  float(mean_absolute_error(yt, yp)),\n",
    "        \"RMSE\": float(np.sqrt(mean_squared_error(yt, yp))),\n",
    "        \"Gini\": gini_index(yt, yp),\n",
    "        \"Mean_Pred\": float(yp.mean()),\n",
    "        \"Mean_Obs\":  float(yt.mean()),\n",
    "        \"Pred_Obs_Ratio\": float(yp.mean() / (yt.mean() + 1e-12)),\n",
    "    }\n",
    "\n",
    "\n",
    "MODELS_EVAL = {\n",
    "    \"GLM\":       \"glm_pure_premium\",\n",
    "    \"NF (ANFIS)\":\"nf_pure_premium\",\n",
    "    \"Ensemble\":  \"ens_pure_premium\",\n",
    "    \"GBM-Stack\": \"stack_pure_premium\",\n",
    "}\n",
    "\n",
    "results_list = []\n",
    "lorenz_data  = {}\n",
    "for name, col in MODELS_EVAL.items():\n",
    "    yp = df_eval[col].values\n",
    "    r  = compute_metrics(y_eval, yp, name)\n",
    "    results_list.append(r)\n",
    "    lorenz_data[name] = lorenz_curve(y_eval, yp)\n",
    "\n",
    "results_df = pd.DataFrame(results_list).sort_values(\"Gini\", ascending=False)\n",
    "results_df[\"Obs_Pure_Premium\"] = obs_pure_prem\n",
    "\n",
    "# Save metrics\n",
    "results_df.to_csv(\"model_comparison_results.csv\", index=False)\n",
    "\n",
    "print(\"\\n\" + \"=\" * 72)\n",
    "print(\"MODEL COMPARISON TABLE  (sorted by Gini)\")\n",
    "print(\"=\" * 72)\n",
    "print(results_df[[\"Model\", \"Gini\", \"MAE\", \"RMSE\", \"Mean_Pred\",\n",
    "                   \"Pred_Obs_Ratio\", \"Obs_Pure_Premium\"]].to_string(\n",
    "    index=False, float_format=\"{:.4f}\".format))\n",
    "print(\"=\" * 72)\n",
    "\n",
    "# --- Lorenz curve figure ---\n",
    "COLORS_LC = {\n",
    "    \"GLM\":        \"#1565C0\",\n",
    "    \"NF (ANFIS)\": \"#E53935\",\n",
    "    \"Ensemble\":   \"#2E7D32\",\n",
    "    \"GBM-Stack\":  \"#F57F17\",\n",
    "}\n",
    "\n",
    "fig, ax = plt.subplots(figsize=(9, 7))\n",
    "ax.plot([0, 1], [0, 1], \"k--\", linewidth=1.2, label=\"Random (Gini=0)\")\n",
    "for name, (cp, cl) in lorenz_data.items():\n",
    "    g   = float(results_df.loc[results_df[\"Model\"] == name, \"Gini\"].values[0])\n",
    "    col = COLORS_LC[name]\n",
    "    ax.plot(cp, cl, color=col, linewidth=2.2,\n",
    "            label=f\"{name}  (Gini = {g:.4f})\")\n",
    "    ax.fill_between(cp, cl, [0] * len(cl), alpha=0.05, color=col)\n",
    "\n",
    "ax.set_title(\"Lorenz Curve Comparison - Motor Insurance Models\\n\"\n",
    "             \"vs Observed Annual Loss  |  Higher = Better discrimination\",\n",
    "             fontsize=12, fontweight=\"bold\")\n",
    "ax.set_xlabel(\"Cumulative proportion of policies (sorted by predicted premium)\", fontsize=10)\n",
    "ax.set_ylabel(\"Cumulative proportion of observed loss\", fontsize=10)\n",
    "ax.legend(loc=\"upper left\", fontsize=10)\n",
    "ax.grid(alpha=0.25)\n",
    "ax.set_xlim(0, 1); ax.set_ylim(0, 1)\n",
    "plt.tight_layout()\n",
    "plt.savefig(\"lorenz_curves.png\", dpi=150, bbox_inches=\"tight\")\n",
    "plt.close()\n",
    "print(\"\\nLorenz curves saved -> lorenz_curves.png\")\n",
    "\n",
    "\n",
    "# --- Decile lift chart ---\n",
    "def decile_table(score, obs, n=10):\n",
    "    tmp = pd.DataFrame({\"score\": score, \"obs\": obs})\n",
    "    tmp[\"decile\"] = pd.qcut(tmp[\"score\"].rank(method=\"first\"), n,\n",
    "                             labels=False) + 1\n",
    "    tab = tmp.groupby(\"decile\").agg(\n",
    "        avg_pred=(\"score\", \"mean\"),\n",
    "        avg_obs=(\"obs\", \"mean\"),\n",
    "        count=(\"obs\", \"count\")\n",
    "    ).reset_index()\n",
    "    tab[\"lift\"] = tab[\"avg_obs\"] / (obs.mean() + 1e-12)\n",
    "    tab[\"residual\"] = tab[\"avg_pred\"] - tab[\"avg_obs\"]\n",
    "    return tab\n",
    "\n",
    "\n",
    "fig2, axes2 = plt.subplots(2, 2, figsize=(14, 10))\n",
    "fig2.suptitle(\n",
    "    \"Decile Lift Tables: Predicted vs Observed Pure Premium\\n\"\n",
    "    f\"(reference observed pure premium = {obs_pure_prem:,.0f})\",\n",
    "    fontsize=12, fontweight=\"bold\"\n",
    ")\n",
    "axf2 = axes2.flatten()\n",
    "\n",
    "for ai, (name, col) in enumerate(MODELS_EVAL.items()):\n",
    "    dec = decile_table(df_eval[col].values, y_eval)\n",
    "    ax  = axf2[ai]\n",
    "    x   = dec[\"decile\"].values\n",
    "    clr = COLORS_LC[name]\n",
    "    ax.bar(x - 0.2, dec[\"avg_pred\"], width=0.4, color=clr, alpha=0.85, label=\"Pred PP\")\n",
    "    ax.bar(x + 0.2, dec[\"avg_obs\"],  width=0.4, color=\"grey\", alpha=0.55, label=\"Obs Loss\")\n",
    "    ax.axhline(obs_pure_prem, color=\"red\", linestyle=\"--\", linewidth=1.2,\n",
    "               label=f\"Obs PP ({obs_pure_prem:,.0f})\")\n",
    "    g = float(results_df.loc[results_df[\"Model\"] == name, \"Gini\"].values[0])\n",
    "    ax.set_title(f\"{name}  (Gini={g:.4f})\", fontsize=10, fontweight=\"bold\")\n",
    "    ax.set_xlabel(\"Decile (1=lowest predicted premium)\")\n",
    "    ax.set_ylabel(\"Average amount\")\n",
    "    ax.legend(fontsize=8)\n",
    "    ax.grid(alpha=0.2, axis=\"y\")\n",
    "\n",
    "plt.tight_layout()\n",
    "plt.savefig(\"decile_lift.png\", dpi=150, bbox_inches=\"tight\")\n",
    "plt.close()\n",
    "print(\"Decile lift chart saved -> decile_lift.png\")\n",
    "\n",
    "# Print decile tables\n",
    "print(\"\\n\" + \"=\" * 72)\n",
    "print(\"DECILE TABLES (Predicted vs Observed Pure Premium)\")\n",
    "print(\"=\" * 72)\n",
    "for name, col in MODELS_EVAL.items():\n",
    "    dec = decile_table(df_eval[col].values, y_eval)\n",
    "    print(f\"\\n--- {name} ---\")\n",
    "    print(dec[[\"decile\",\"count\",\"avg_pred\",\"avg_obs\",\"lift\",\"residual\"]].to_string(\n",
    "        index=False, float_format=\"{:.2f}\".format))\n",
    "\n",
    "# --- Tiered pricing bands ---\n",
    "print(\"\\n\" + \"=\" * 72)\n",
    "print(\"TIERED PRICING BANDS (Based on Stacker Test Deciles)\")\n",
    "print(\"=\" * 72)\n",
    "stack_dec = decile_table(df_eval[\"stack_pure_premium\"].values, y_eval)\n",
    "bands = {\n",
    "    \"Low Risk (1-4)\": stack_dec[stack_dec[\"decile\"] <= 4],\n",
    "    \"Medium Risk (5-8)\": stack_dec[(stack_dec[\"decile\"] >= 5) & (stack_dec[\"decile\"] <= 8)],\n",
    "    \"High Risk (9-10)\": stack_dec[stack_dec[\"decile\"] >= 9]\n",
    "}\n",
    "for band, bdata in bands.items():\n",
    "    total_count = bdata[\"count\"].sum()\n",
    "    if total_count > 0:\n",
    "        avg_pred = (bdata[\"avg_pred\"] * bdata[\"count\"]).sum() / total_count\n",
    "        avg_obs = (bdata[\"avg_obs\"] * bdata[\"count\"]).sum() / total_count\n",
    "        lift = avg_obs / (y_eval.mean() + 1e-12)\n",
    "        print(f\"{band:<20} | N={total_count:>5} | Avg Pred: {avg_pred:>7.2f} | Avg Obs: {avg_obs:>7.2f} | Lift: {lift:.2f}\")\n",
    "\n",
    "\n",
    "# --- Survival curves (ANFIS fuzzy scenarios) ---\n",
    "print(\"\\n\" + \"=\" * 70)\n",
    "print(\"SECTION 7h - FUZZY SCENARIO SURVIVAL CURVES\")\n",
    "print(\"=\" * 70)\n",
    "\n",
    "SCENARIOS = [\n",
    "    (24,  2,  2,  6000, 1000, \"Young-Novice-New-Budget\"),\n",
    "    (24,  2, 15, 45000, 2500, \"Young-Novice-Old-Luxury\"),\n",
    "    (42,  8,  7, 15000, 1600, \"Adult-Average-Mid-Mid\"),\n",
    "    (67, 22, 15,  6000, 1000, \"Senior-Expert-Old-Budget\"),\n",
    "    (42, 22,  2, 45000, 2500, \"Adult-Expert-New-Luxury\"),\n",
    "]\n",
    "\n",
    "t_grid = np.linspace(0, 5, 300)\n",
    "fig3, ax3 = plt.subplots(figsize=(9, 5))\n",
    "SC_COLORS = [\"#2196F3\", \"#F44336\", \"#4CAF50\", \"#FF9800\", \"#9C27B0\"]\n",
    "\n",
    "for (age, exp, va, val, cc, label), col in zip(SCENARIOS, SC_COLORS):\n",
    "    x_raw = np.array([[age, exp, va, val, cc]], dtype=np.float32)\n",
    "    lam_v, _ = nf_predict(x_raw)\n",
    "    lam_val = float(lam_v[0])\n",
    "    S = np.exp(-lam_val * t_grid)\n",
    "    ax3.plot(t_grid, S, color=col, linewidth=2,\n",
    "             label=f\"{label}  lambda={lam_val:.4f}\")\n",
    "\n",
    "ax3.set_title(\"Calibrated No-Claim Survival Curves by Fuzzy Scenario\\n\"\n",
    "              \"S(t) = exp(-lambda * t)  (higher lambda = more claims)\",\n",
    "              fontsize=11, fontweight=\"bold\")\n",
    "ax3.set_xlabel(\"Time (years)\")\n",
    "ax3.set_ylabel(\"P(no claim up to time t)\")\n",
    "ax3.legend(fontsize=8.5, loc=\"upper right\")\n",
    "ax3.grid(alpha=0.25)\n",
    "ax3.set_ylim(0, 1)\n",
    "plt.tight_layout()\n",
    "plt.savefig(\"survival_curves.png\", dpi=150, bbox_inches=\"tight\")\n",
    "plt.close()\n",
    "print(\"Survival curves saved -> survival_curves.png\")\n",
    "\n",
    "# =============================================================================\n",
    "# SECTION 8 - FINAL REPORT SUMMARY\n",
    "# =============================================================================\n",
    "print(\"\\n\" + \"=\" * 70)\n",
    "print(\"SECTION 8 - FINAL REPORT SUMMARY\")\n",
    "print(\"=\" * 70)\n",
    "\n",
    "best_row   = results_df.iloc[0]\n",
    "best_gini_all = float(best_row[\"Gini\"])\n",
    "\n",
    "print(\"\\nFUZZY SYSTEM CONFIGURATION:\")\n",
    "print(f\"  Variables        : {len(FUZZY_DEFS)}\")\n",
    "print(f\"  Terms per var    : 3  (Trainable Gaussian MFs)\")\n",
    "print(f\"  Total rules      : {N_RULES}  (3^5 = 243 rules)\")\n",
    "print(f\"  MF type         : Gaussian with softplus-enforced sigma\")\n",
    "\n",
    "print(\"\\nGLM MODELS:\")\n",
    "print(f\"  Frequency  : Negative Binomial GLM\")\n",
    "print(f\"  Severity   : Gamma GLM (log link)\")\n",
    "\n",
    "print(f\"\\nNEURO-FUZZY TRAINING:\")\n",
    "print(f\"  Architecture : ANFIS + MLP (128 -> 32 -> 1 per head)\")\n",
    "print(f\"  Freq loss    : Poisson NLL + Pairwise ranking ({RANK_WEIGHT}x)\")\n",
    "print(f\"  Sev loss     : Huber (beta=1.0) + Pairwise ranking ({RANK_WEIGHT}x)\")\n",
    "print(f\"  Optim        : AdamW, cosine LR, early-stop patience={PATIENCE}\")\n",
    "print(f\"  Epochs done  : {len(history)}\")\n",
    "\n",
    "print(f\"\\nPREMIUM SUMMARY (OOS Evaluated vs Observed Pure Premium = {obs_pure_prem:,.2f}):\")\n",
    "for name, col in MODELS_EVAL.items():\n",
    "    mn = float(df_eval[col].mean())\n",
    "    g  = float(results_df.loc[results_df[\"Model\"] == name, \"Gini\"].values[0])\n",
    "    print(f\"  {name:<15}: mean={mn:>10,.2f}  Gini={g:.4f}\")\n",
    "\n",
    "print(\"\\nGINI PERFORMANCE:\")\n",
    "for _, row in results_df.iterrows():\n",
    "    flag = \"[OK > 0.35]\" if row[\"Gini\"] > 0.35 else \"          \"\n",
    "    print(f\"  {flag} {row['Model']:<15}: Gini={row['Gini']:.4f} \"\n",
    "          f\"| MAE={row['MAE']:.2f} | RMSE={row['RMSE']:.2f}\")\n",
    "\n",
    "if best_gini_all > 0.35:\n",
    "    print(f\"\\n[SUCCESS] Best model '{best_row['Model']}' \"\n",
    "          f\"Gini ({best_gini_all:.4f}) exceeds 0.35 target.\")\n",
    "else:\n",
    "    print(f\"\\n[NOTE] Best Gini = {best_gini_all:.4f}  \"\n",
    "          f\"(target 0.35 - consider increasing EPOCHS or RANK_WEIGHT)\")\n",
    "\n",
    "print(\"\\nOUTPUT FILES:\")\n",
    "for fname in [\"mf_plots.png\", \"lorenz_curves.png\", \"decile_lift.png\",\n",
    "              \"survival_curves.png\", \"model_comparison_results.csv\"]:\n",
    "    mark = \"[OK]\" if os.path.exists(fname) else \"[MISSING]\"\n",
    "    print(f\"  {mark}  {fname}\")\n",
    "\n",
    "print(\"\\n\" + \"=\" * 70)\n",
    "print(\"Pipeline complete.\")\n",
    "print(\"=\" * 70 + \"\\n\")\n"
   ]
