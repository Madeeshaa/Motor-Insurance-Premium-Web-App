    "import streamlit as st\n",
    "import numpy as np\n",
    "\n",
    "def predict_pure_premium(age, exp, v_age, v_value, cc):\n",
    "    # Replace with your trained model call\n",
    "    return 350.0  # placeholder\n",
    "\n",
    "st.title(\"Motor Insurance Premium Calculator\")\n",
    "\n",
    "birth_year = st.number_input(\"Birth Year\", min_value=1940, max_value=2020, value=1985)\n",
    "licence_year = st.number_input(\"Year Licence Issued\", min_value=1960, max_value=2025, value=2005)\n",
    "matric_year = st.number_input(\"Vehicle Matriculation Year\", min_value=1970, max_value=2025, value=2015)\n",
    "vehicle_value = st.number_input(\"Vehicle Current Value (€)\", min_value=500, max_value=100000, value=15000)\n",
    "cc = st.number_input(\"Cylinder Capacity (cc)\", min_value=600, max_value=4000, value=1600)\n",
    "\n",
    "ref_year = 2026  # or dynamically set to contract start year\n",
    "age = ref_year - birth_year\n",
    "exp = ref_year - licence_year\n",
    "v_age = ref_year - matric_year\n",
    "v_value = np.log1p(vehicle_value)\n",
    "\n",
    "loading = st.slider(\"Premium Loading (%)\", 0, 50, 15)\n",
    "\n",
    "pure_premium = predict_pure_premium(age, exp, v_age, v_value, cc)\n",
    "final_premium = pure_premium * (1 + loading/100)\n",
    "\n",
    "st.write(f\"**Pure Premium:** €{pure_premium:.2f}\")\n",
    "st.write(f\"**Final Premium (with {loading}% loading):** €{final_premium:.2f}\")\n"
   ]
